<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>UFeel</string>
	<key>NSHealthShareUsageDescription</key>
	<string>UFeel reads your heart rate to stream it to the computer running the UFeel library.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>UFeel runs a workout to measure your heart rate continuously. The workout is not saved.</string>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.ufeel.heartrate</string>
</dict>
</plist>
